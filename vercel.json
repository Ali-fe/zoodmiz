{
  "$schema": "https://open.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && npm run install_server && npm run install_client",
  "buildCommand": "npm run build",
  "outputDirectory": "server/public",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/public/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
