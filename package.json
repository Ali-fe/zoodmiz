{
  "name": "digital_menu",
  "version": "1.0.0",
  "description": "full stack restaurant digital menu managnet project",
  "main": "index.js",
  "scripts": {
    "install_server": "npm install --prefix server",
    "install_client": "npm install --prefix client",
    "server":"cd server && nodemon ./src/server",
    "client":"cd client && npm run dev",
    "deploy": "npm run deploy --prefix client && npm start --prefix server",
    "watch": "npm run watch --prefix server",
    "startup-project": "npm install && npm run install_server && npm run install_client",
    "dev" : "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ali-fe/digital_menu.git"
  },
  "author": "Ali Fereidouni",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Ali-fe/digital_menu/issues"
  },
  "homepage": "https://github.com/Ali-fe/digital_menu#readme",
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
